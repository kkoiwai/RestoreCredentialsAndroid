# ========================================================
# Restore Credentials Server Configuration
# ========================================================

# Server Port (default: 8080)
PORT=8080

# WebAuthn Relying Party Name
RP_NAME=Restore Credentials PoC

# WebAuthn Relying Party ID (hostname without port or scheme)
# For local emulator: localhost
# For production Cloud Run: your-service-xxxx-an.a.run.app
RP_ID=localhost

# OIDC Issuer URL (defaults to http://localhost:8080 or https://<RP_ID>)
# ISSUER=http://localhost:8080

# OIDC Client ID expected from client apps (default: android-poc-client)
CLIENT_ID=android-poc-client

# OAuth Redirect URI expected for the client app (default: restoreapp://auth-callback)
REDIRECT_URI=restoreapp://auth-callback

# Android App Certificate SHA-256 Fingerprints (comma separated hex strings)
# Optional: used for strict android:apk-key-hash origin verification
# ANDROID_CERT_FINGERPRINTS=14:6D:E9:48:01:FE:EA:5F:9E:1A:1D:91:86:B6:6B:1A:E6:9A:AE:52:98:CE:57:3E:1A:F3:11:A6:49:15:3F:8A

# Additional allowed WebAuthn origins (comma separated)
# ADDITIONAL_ORIGINS=http://localhost:3000,https://example.com
